{
  "name": "@claudio/desktop",
  "version": "0.5.0",
  "private": true,
  "description": "Electron desktop shell for Claudio",
  "homepage": "https://github.com/yeyo11/claudio",
  "license": "MIT",
  "author": {
    "name": "Jose Antonio Garrido",
    "email": "yeyochico@gmail.com"
  },
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "pnpm --filter @claudio/web build && pnpm --filter @claudio/api bundle && pnpm run build && electron . --dev --no-sandbox",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/test-tmp.mjs tsx --test --test-timeout=240000 --test-force-exit test/*.test.ts",
    "dist:linux": "pnpm --filter @claudio/web build && pnpm --filter @claudio/api bundle && pnpm run build && electron-builder --linux --config electron-builder.yml --publish never"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@claudio/core": "workspace:*",
    "electron-updater": "^6.8.9"
  }
}
