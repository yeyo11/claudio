{
  "name": "@claudio/api",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/test-tmp.mjs tsx --test --test-timeout=240000 --test-force-exit test/*.test.ts",
    "openapi:schemas": "tsx scripts/generate-schemas.ts",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@claudio/accounts": "workspace:*",
    "@claudio/core": "workspace:*",
    "@claudio/shared": "workspace:*",
    "@fastify/compress": "^9.2.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/etag": "^6.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/websocket": "^11.3.4",
    "@scalar/fastify-api-reference": "^1.74.0",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  }
}
