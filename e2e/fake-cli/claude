#!/usr/bin/env node
// A fake `claude` for the e2e suite: it speaks just enough of the CLI's stream-json to give the
// wrapper a live process to act on, which the sandbox cannot get from the real one without a login
// and a model. README.md beside it describes the surface; nothing here calls a model or the network.
//
// A turn is driven by its prompt: every line `run: <command>` is one Bash call, run for real by
// `sh -c` in the working directory, one after the other, and a line `elapsed: <seconds>` adds that
// much to what the heartbeats of this process say from then on. A prompt with no `run:` line is
// answered with `Heard: <its first line>`. Messages that arrive while a turn runs are answered the
// same way at its next step, between two calls; messages that arrive between turns start one each.
// A line `say: <text>` is a paragraph of the assistant's, in its place among the calls.
// With `--replay-user-messages` each message is read back, under the `uuid` its stdin line carried,
// the moment a turn takes it, as the CLI does (docs/chat-delivery.md); its transcript line keeps that id.
import { spawn, spawnSync } from 'node:child_process';
import { randomUUID } from 'node:crypto';
import { appendFileSync, existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import { createInterface } from 'node:readline';
import { fileURLToPath } from 'node:url';

const argv = process.argv.slice(2);
const env = process.env;
// A recording of the UI wants a footer that reads like an account, not like the test double it is
const VERSION = env.CLAUDIO_FAKE_CLI_VERSION || '2.1.1-fake';
function authStatus() {
  let extra = {};
  try {
    extra = env.CLAUDIO_FAKE_CLI_AUTH ? JSON.parse(env.CLAUDIO_FAKE_CLI_AUTH) : {};
  } catch {
    // an unreadable override leaves the fake's own answer
  }
  return { loggedIn: true, authMethod: 'fake', apiProvider: 'firstParty', ...extra };
}
function numberEnv(name, fallback) {
  const raw = env[name];
  return raw !== undefined && raw !== '' && Number(raw) >= 0 ? Number(raw) : fallback;
}
/** Added to every heartbeat's elapsed time: a spec makes a command look hung without waiting minutes for it */
let elapsedOffsetS = numberEnv('CLAUDIO_FAKE_CLI_ELAPSED_S', 0);
/** The real CLI beats every 30 s; a spec wants to see one sooner */
const HEARTBEAT_MS = numberEnv('CLAUDIO_FAKE_CLI_HEARTBEAT_MS', 30_000);
const TURN_COST_USD = numberEnv('CLAUDIO_FAKE_CLI_TURN_COST_USD', 0);
/** How long the worker "thinks" between two steps: long enough for a message sent with a cancel to arrive first */
const SETTLE_MS = 300;
// How long a `read:` step holds its Read call open, so a page can show what is being read
const READ_MS = numberEnv('CLAUDIO_FAKE_CLI_READ_MS', 400);
// How long a `/compact` takes before its boundary: long enough for a page to show the chat compacting
const COMPACT_MS = numberEnv('CLAUDIO_FAKE_CLI_COMPACT_MS', 1500);

/** What a spec reads to know the process heard something: one JSON line per fact, when the variable names a file. */
function log(event, fields = {}) {
  if (!env.CLAUDIO_FAKE_CLI_LOG) return;
  try {
    appendFileSync(env.CLAUDIO_FAKE_CLI_LOG, `${JSON.stringify({ at: new Date().toISOString(), pid: process.pid, event, ...fields })}\n`);
  } catch {
    // a log that cannot be written only costs the spec its evidence
  }
}

function flag(name) {
  const at = argv.indexOf(name);
  if (at !== -1) return argv[at + 1];
  const inline = argv.find((a) => a.startsWith(`${name}=`));
  return inline === undefined ? undefined : inline.slice(name.length + 1);
}

// ---------- the subcommands the wrapper runs besides a chat ----------

function subcommand() {
  const [first, second, third] = argv.filter((a) => !a.startsWith('-'));
  if (argv[0] === '--version' || argv[0] === '-v') return `${VERSION} (Claude Code)\n`;
  if (first === 'auth' && second === 'status') return `${JSON.stringify(authStatus())}\n`;
  if (first === 'agents') return '[]\n';
  if (first === 'mcp' && second === 'list') return 'No MCP servers configured. Use `claude mcp add` to add a server.\n';
  if (first === 'plugin' && (second === 'list' || (second === 'marketplace' && third === 'list'))) return '[]\n';
  return null;
}

if (!argv.includes('-p') && !argv.includes('--print')) {
  const out = subcommand();
  if (out === null) {
    process.stderr.write(`fake claude: \`${argv.join(' ')}\` is not part of the fake (e2e/fake-cli)\n`);
    process.exit(1);
  }
  process.stdout.write(out);
  process.exit(0);
}
if (flag('--input-format') !== 'stream-json' || flag('--output-format') !== 'stream-json') {
  process.stderr.write('fake claude: only `-p --input-format stream-json --output-format stream-json` is faked\n');
  process.exit(1);
}

// ---------- a chat ----------

const sessionId = flag('--session-id') ?? flag('--resume') ?? randomUUID();
let permissionMode = flag('--permission-mode') ?? 'default';
const modelName = (m) => (m.includes('-') ? m : `claude-${m}-5`);
let model = modelName(flag('--model') ?? 'sonnet');
let turns = 0;
let costUsd = 0;

/**
 * What the context holds, as the assistant lines' usage report it. A spec that wants a meter worth
 * watching sets `"@context": <tokens>` in the scripts file (read when the process starts); a
 * compaction brings it down to the recorded `post_tokens`.
 */
let contextTokens = (() => {
  try {
    const set = env.CLAUDIO_FAKE_CLI_SCRIPTS ? JSON.parse(readFileSync(env.CLAUDIO_FAKE_CLI_SCRIPTS, 'utf8'))['@context'] : undefined;
    return Number.isFinite(set) && set > 0 ? set : 10;
  } catch {
    return 10;
  }
})();

/**
 * `--worktree <name>` as the CLI does it: a worktree of the repository under `.claude/worktrees/<name>`,
 * on a branch `worktree-<name>`, which the session then works in. Outside a repository the flag
 * changes nothing, and the fake says so on stderr instead of failing the chat.
 */
function enterWorktree(name) {
  const git = (...args) => spawnSync('git', args, { cwd: process.cwd(), encoding: 'utf8' });
  const top = git('rev-parse', '--show-toplevel');
  if (top.status !== 0) {
    process.stderr.write(`fake claude: --worktree ${name} outside a git repository; working in place\n`);
    return;
  }
  const dir = join(top.stdout.trim(), '.claude', 'worktrees', name);
  if (!existsSync(dir)) {
    mkdirSync(dirname(dir), { recursive: true });
    const added = git('worktree', 'add', '-q', '-b', `worktree-${name}`, dir, 'HEAD');
    if (added.status !== 0) {
      process.stderr.write(`fake claude: could not add the worktree: ${added.stderr}`);
      process.exit(1);
    }
  }
  process.chdir(dir);
}
const worktree = flag('--worktree');
if (worktree) enterWorktree(worktree);

/**
 * The transcript the CLI writes to `$CLAUDE_CONFIG_DIR/projects/<cwd>/<session>.jsonl`, in its own
 * shape, when `CLAUDIO_FAKE_CLI_TRANSCRIPT=1` or the scripts file has `"@transcript": true` (a spec
 * cannot set the server's environment). Off by default, and never without `CLAUDE_CONFIG_DIR`, so
 * the real `~/.claude` is not written. A message read in the middle of a turn is written the way CLI
 * 2.1 writes it: `queue-operation` lines and an `attachment` of type `queued_command`, no `user` line.
 */
function transcriptOn() {
  if (!env.CLAUDE_CONFIG_DIR) return false;
  if (env.CLAUDIO_FAKE_CLI_TRANSCRIPT === '1') return true;
  try {
    return env.CLAUDIO_FAKE_CLI_SCRIPTS ? JSON.parse(readFileSync(env.CLAUDIO_FAKE_CLI_SCRIPTS, 'utf8'))['@transcript'] === true : false;
  } catch {
    return false;
  }
}
const replays = argv.includes('--replay-user-messages');
/** The CLI reads a message back once it has taken it: at the start of its turn, or when a turn absorbs it */
const replay = (text, uuid) => {
  if (replays && uuid) emit({ type: 'user', isReplay: true, uuid, parent_tool_use_id: null, message: { role: 'user', content: text } });
};
const transcriptFile = transcriptOn() ? join(env.CLAUDE_CONFIG_DIR, 'projects', process.cwd().replace(/[^a-zA-Z0-9]/g, '-'), `${sessionId}.jsonl`) : null;
let lastLine = null;
function record(line) {
  if (!transcriptFile) return;
  const at = new Date().toISOString();
  const full = line.type === 'queue-operation' ? { ...line, timestamp: at, sessionId } : { parentUuid: lastLine, isSidechain: false, ...line, timestamp: at, cwd: process.cwd(), sessionId, version: VERSION };
  if (full.uuid) lastLine = full.uuid;
  try {
    mkdirSync(dirname(transcriptFile), { recursive: true });
    appendFileSync(transcriptFile, `${JSON.stringify(full)}\n`);
  } catch {
    // a transcript that cannot be written only costs the spec its evidence
  }
}

const emit = (message) => process.stdout.write(`${JSON.stringify({ ...message, session_id: sessionId })}\n`);
/**
 * A subagent's lines go out as the CLI streams a sidechain (`parent_tool_use_id` the launching call's id) and
 * are written to the agent's own transcript instead of the session's; `branch` is that subagent, null for the main agent.
 */
const sidechain = (branch) => (branch ? { parent_tool_use_id: branch.toolUseId, isSidechain: true } : { parent_tool_use_id: null });
const assistant = (content, branch = null) => {
  const message = { type: 'assistant', uuid: randomUUID(), ...sidechain(branch), message: { id: `msg_${randomUUID()}`, type: 'message', role: 'assistant', model, content, usage: { input_tokens: contextTokens, output_tokens: 10 } } };
  emit(message);
  (branch ? branch.record : record)({ type: 'assistant', uuid: message.uuid, message: message.message });
};
/**
 * A tool result, with what the CLI records beside it (`detail`): `tool_use_result` on the stream and
 * `toolUseResult` in the transcript, in the shape the real tool gives (an object, or a string for a call that failed).
 */
const toolResult = (toolUseId, content, isError, detail = undefined, branch = null) => {
  const message = { type: 'user', uuid: randomUUID(), ...sidechain(branch), message: { role: 'user', content: [{ type: 'tool_result', tool_use_id: toolUseId, content, is_error: isError }] }, ...(detail === undefined ? {} : { tool_use_result: detail }) };
  emit(message);
  (branch ? branch.record : record)({ type: 'user', uuid: message.uuid, message: message.message, ...(detail === undefined ? {} : { toolUseResult: detail }) });
};
const newToolId = () => `toolu_fake_${randomUUID().replaceAll('-', '').slice(0, 20)}`;

/** A `Read` answered as the CLI answers it: the text, and `{ type: 'text', file }` beside it. */
function readResult(filePath) {
  try {
    const whole = readFileSync(filePath, 'utf8');
    const content = whole.slice(0, 4000);
    const lines = (text) => (text === '' ? 0 : text.replace(/\n$/, '').split('\n').length);
    return { content, detail: { type: 'text', file: { filePath, content, numLines: lines(content), startLine: 1, totalLines: lines(whole) } } };
  } catch {
    // A path that is not there reads as the CLI says so, and a failed call records a string
    return { content: '(file not found)', detail: '(file not found)' };
  }
}

/** A finished `Bash` as the CLI answers it: the text, and `{ stdout, stderr, interrupted }` beside it, or the error as a string. */
function commandResult(stdout, stderr, code, signal) {
  const ok = code === 0;
  const content = ((stdout + stderr).trim() || (ok ? '(no output)' : `Exit code ${code ?? signal}`)).slice(0, 4000);
  const detail = ok ? { stdout: stdout.replace(/\n$/, ''), stderr: stderr.replace(/\n$/, ''), interrupted: false, isImage: false, noOutputExpected: false } : `Error: ${content}`;
  return { content, isError: !ok, detail };
}

/** The `init` a session opens with; a failed compaction opens another, as the recording shows */
function init() {
  emit({
    type: 'system',
    subtype: 'init',
    cwd: process.cwd(),
    model,
    permissionMode,
    // The subagent tool a real CLI always lists: without it the detector reads the first session as a
    // CLI missing subagents, and Claude Code turns `degraded` for every spec after it
    tools: ['Agent', 'Bash'],
    mcp_servers: [],
    slash_commands: ['compact', 'context', 'cost', 'review'],
    claude_code_version: VERSION,
    output_style: 'default',
    agents: [],
    skills: [],
    plugins: [],
  });
}
// ---------- the hooks of --settings (g0's contract): SessionStart arms, PreToolUse can block ----------

const settingsFile = flag('--settings');
let hookCommands = {};
try {
  hookCommands = settingsFile ? (JSON.parse(readFileSync(settingsFile, 'utf8')).hooks ?? {}) : {};
} catch {
  // an unreadable settings file means no hooks, as for the CLI
}
const hookEvents = argv.includes('--include-hook-events');
/**
 * Runs the first command of a hook event the way the CLI does: `sh -c` with the hook input on stdin.
 * With `--include-hook-events` it streams `hook_started` and `hook_response`, in the shape g0 recorded.
 * Only exit 2 blocks; any other code lets the call run.
 */
function runHook(event, name, input) {
  const command = hookCommands[event]?.[0]?.hooks?.[0]?.command;
  if (!command) return null;
  const hookId = randomUUID();
  if (hookEvents) emit({ type: 'system', subtype: 'hook_started', hook_id: hookId, hook_name: name, hook_event: event, uuid: randomUUID() });
  const ran = spawnSync('/bin/sh', ['-c', command], { input: JSON.stringify({ session_id: sessionId, cwd: process.cwd(), hook_event_name: event, ...input }), encoding: 'utf8' });
  const code = ran.status ?? 1;
  if (hookEvents) {
    emit({ type: 'system', subtype: 'hook_response', hook_id: hookId, hook_name: name, hook_event: event, output: `${ran.stdout}${ran.stderr}`, stdout: ran.stdout, stderr: ran.stderr, exit_code: code, outcome: code === 0 ? 'success' : 'error', uuid: randomUUID() });
  }
  return { code, command, stderr: ran.stderr };
}
// SessionStart runs when the process starts, before `init` and before any message (g0, F9)
if (settingsFile && env.CLAUDIO_FAKE_CLI_NO_ARM !== '1') runHook('SessionStart', `SessionStart:${flag('--resume') ? 'resume' : 'startup'}`, { source: flag('--resume') ? 'resume' : 'startup' });
/**
 * The PreToolUse hook of a Bash call, run after the call is announced as the CLI does. Returns the text the
 * model gets for an exit 2 (F5), or null when the call may run. `CLAUDIO_FAKE_CLI_NO_HOOKS=1` never runs it:
 * a guard that is not there, which the wrapper's liveness check must notice.
 */
function bashBlock(id, command) {
  if (env.CLAUDIO_FAKE_CLI_NO_HOOKS === '1') return null;
  const verdict = runHook('PreToolUse', 'PreToolUse:Bash', { tool_name: 'Bash', tool_input: { command, description: `Run ${command}` }, tool_use_id: id });
  return verdict?.code === 2 ? `PreToolUse:Bash hook error: [${verdict.command}]: ${verdict.stderr}` : null;
}

init();
log('started', { argv, cwd: process.cwd() });

/** Every descendant of a pid, children before parents, read from /proc: a command's tree, never matched by name. */
function descendants(root) {
  const children = new Map();
  let names = [];
  try {
    names = readdirSync('/proc').filter((n) => /^\d+$/.test(n));
  } catch {
    return [];
  }
  for (const name of names) {
    try {
      const stat = readFileSync(`/proc/${name}/stat`, 'utf8');
      const ppid = Number(stat.slice(stat.lastIndexOf(')') + 2).split(' ')[1]);
      children.set(ppid, [...(children.get(ppid) ?? []), Number(name)]);
    } catch {
      // gone in between
    }
  }
  const out = [];
  const walk = (pid) => {
    for (const child of children.get(pid) ?? []) {
      walk(child);
      out.push(child);
    }
  };
  walk(root);
  return out;
}

function killTree(pid, signal = 'SIGTERM') {
  for (const victim of [...descendants(pid), pid]) {
    try {
      process.kill(victim, signal);
    } catch {
      // already gone
    }
  }
}

/** The turn in progress: the steps left, and the command running now */
let turn = null;
/** Messages that arrived during a turn, answered at its next step */
const waiting = [];
/** Messages left for after the turn, each of which starts one */
const inbox = [];

function textOf(message) {
  const content = message?.message?.content;
  if (typeof content === 'string') return content;
  if (Array.isArray(content)) return content.filter((b) => b?.type === 'text').map((b) => b.text).join('\n');
  return '';
}
const firstLine = (text) => text.trim().split('\n')[0] ?? '';
const heard = (text) => ({ type: 'text', text: `Heard: ${firstLine(text)}` });

/**
 * Turns written elsewhere, so the prompt a page shows reads like a person's and not like a script:
 * `CLAUDIO_FAKE_CLI_SCRIPTS` names a JSON object of `{ "<text>": "<script>" }`, and a message that
 * contains one of the texts is played as its script. A worker's prompt is its task wrapped in the
 * orchestrator's own words, which is why a key is looked for inside the message and not matched whole.
 */
function scriptFor(text) {
  // `review.triage` asks one question per thread ("<id>: Who should take this review comment…"): the
  // first thread is the agent's and the rest are a person's, so a spec sees marks without a script
  const asked = [...text.matchAll(/^(\S+): Who should take this review comment/gm)].map((m) => m[1]);
  if (asked.length > 0) return `json: ${JSON.stringify(Object.fromEntries(asked.map((id, i) => [id, i === 0 ? 'agent' : 'person'])))}`;
  // `issue.triage` asks one question per issue ("<key>: Can an agent start on issue …"): the marks go round
  // ready, needs-refining, not-for-agents in the order asked, so a spec sees all three without a script
  const issues = [...text.matchAll(/^(\S+): Can an agent start on issue/gm)].map((m) => m[1]);
  if (issues.length > 0) return `json: ${JSON.stringify(Object.fromEntries(issues.map((id, i) => [id, ['ready', 'needs-refining', 'not-for-agents'][i % 3]])))}`;
  if (!env.CLAUDIO_FAKE_CLI_SCRIPTS) return text;
  let scripts;
  try {
    scripts = JSON.parse(readFileSync(env.CLAUDIO_FAKE_CLI_SCRIPTS, 'utf8'));
  } catch {
    return text;
  }
  const key = Object.keys(scripts).find((k) => k && text.includes(k));
  return key === undefined ? text : String(scripts[key]);
}

function startTurn(message, uuid = null) {
  if (/^\/compact(\s|$)/.test(message.trim())) return startCompact(message, uuid);
  record({ type: 'user', uuid: uuid ?? randomUUID(), message: { role: 'user', content: message } });
  replay(message, uuid);
  const text = scriptFor(message);
  const offset = /^\s*elapsed:\s*(\d+)\s*$/m.exec(text)?.[1];
  if (offset !== undefined) elapsedOffsetS = Number(offset);
  const steps = text
    .split('\n')
    .map((l) => /^\s*(run|say|read|json|stream|hold|ask|agent|background):\s*(.+)$/.exec(l))
    .filter((m) => m?.[2]?.trim())
    .map((m) => ({ kind: m[1], text: m[2].trim() }));
  const commands = steps.filter((s) => s.kind === 'run').map((s) => s.text);
  // A turn that writes its own prose needs none of the fake's around it
  const scripted = steps.some((s) => s.kind === 'say' || s.kind === 'json' || s.kind === 'stream');
  turn = { steps, current: null, startedAt: Date.now(), interrupted: false, scripted, lastSaid: '', structured: undefined, launches: [] };
  log('turn', { text, commands });
  // A line `FAKE-LIMIT` is the account's usage limit, as the CLI's stream-json reports it: a rejected
  // `rate_limit_event` whose window resets in an hour, then a result that failed with a 429. The same
  // prompt sent again fails again, so a spec can tell a rotation that moved the chat from one that retried
  // `FAKE-LIMIT-ACCOUNT` is the same, but only on the account whose token starts with `fake-limited`
  // (`CLAUDE_CODE_OAUTH_TOKEN`): on any other account the line is an ordinary prompt, so a spec can see
  // a chat leave the limited account and be replayed on one with room
  const limitedHere = /^FAKE-LIMIT\s*$/m.test(text) || (/^FAKE-LIMIT-ACCOUNT\s*$/m.test(text) && (env.CLAUDE_CODE_OAUTH_TOKEN ?? '').startsWith('fake-limited'));
  if (limitedHere) {
    emit({ type: 'rate_limit_event', rate_limit_info: { status: 'rejected', rateLimitType: 'five_hour', resetsAt: Math.floor(Date.now() / 1000) + 3600, unifiedWindows: { '5h': { utilization: 1 } } } });
    turn = null;
    turns++;
    emit({ type: 'result', subtype: 'error_during_execution', is_error: true, api_error_status: 429, num_turns: 1, total_cost_usd: costUsd, result: "You've hit your usage limit" });
    log('result', { error: true, turns, limit: true });
    const next = inbox.shift();
    if (next !== undefined) setImmediate(() => startTurn(next.text, next.uuid));
    return;
  }
  // A line `FAKE-LIMIT-CLEAR` is the window back to normal: an allowed `rate_limit_event` at no use, so a
  // spec that drove the account to its limit can leave it as it found it for the specs after it
  if (/^FAKE-LIMIT-CLEAR\s*$/m.test(text)) {
    emit({ type: 'rate_limit_event', rate_limit_info: { status: 'allowed', rateLimitType: 'five_hour', resetsAt: Math.floor(Date.now() / 1000) + 3600, unifiedWindows: { '5h': { utilization: 0 } } } });
    assistant([heard(text)]);
    endTurn({ result: 'Limit cleared' });
    return;
  }
  if (steps.length === 0) {
    assistant([heard(text)]);
    endTurn({ result: `Heard: ${firstLine(text)}` });
    return;
  }
  if (!scripted) assistant([{ type: 'text', text: `Running ${commands.length} ${commands.length === 1 ? 'command' : 'commands'}.` }]);
  nextStep();
}

function nextStep() {
  const own = turn;
  if (!own) return;
  const step = own.steps.shift();
  // A background agent's sidechain follows the step after its launch, so a page sees it running meanwhile
  const launches = own.launches.splice(0);
  if (launches.length) setTimeout(() => launches.forEach((go) => go()), SETTLE_MS);
  // What a `stream:` held back goes out before anything but the `hold:` that holds it
  if (own.streamRest !== undefined && step?.kind !== 'hold') finishStream(own);
  if (step === undefined) {
    if (!own.scripted) assistant([{ type: 'text', text: 'All done.' }]);
    endTurn({ result: own.scripted ? own.lastSaid : 'All done.', structured: own.structured });
    return;
  }
  if (step.kind === 'json') {
    // What `--json-schema` makes the CLI return beside its text
    try {
      own.structured = JSON.parse(step.text);
    } catch {
      own.structured = step.text;
    }
    setTimeout(() => turn === own && nextStep(), 0);
    return;
  }
  if (step.kind === 'stream') {
    // As the CLI hands a `--json-schema` result over: the input of its StructuredOutput tool call,
    // streamed as input_json_delta events (it runs with --include-partial-messages). The first half
    // goes out now, the rest before the next step, or once a `hold:` lets it
    own.structured = JSON.parse(step.text);
    const half = Math.floor(step.text.length / 2);
    streamEvent({ type: 'content_block_start', index: 0, content_block: { type: 'tool_use', id: 'toolu_fake_structured', name: 'StructuredOutput', input: {} } });
    streamDeltas(step.text.slice(0, half));
    own.streamRest = step.text.slice(half);
    setTimeout(() => turn === own && nextStep(), SETTLE_MS);
    return;
  }
  if (step.kind === 'hold') {
    // Waits for <path> (against the working directory) to exist: a spec holds a turn in the middle
    const path = resolve(process.cwd(), step.text);
    const wait = setInterval(() => {
      if (turn !== own) return clearInterval(wait);
      if (!existsSync(path)) return;
      clearInterval(wait);
      nextStep();
    }, 50);
    return;
  }
  if (step.kind === 'read') {
    const id = newToolId();
    const filePath = resolve(process.cwd(), step.text);
    assistant([{ type: 'tool_use', id, name: 'Read', input: { file_path: filePath } }]);
    own.current = { id, child: null, command: null };
    setTimeout(() => {
      if (turn !== own) return;
      own.current = null;
      const { content, detail } = readResult(filePath);
      toolResult(id, content, false, detail);
      setTimeout(() => turn === own && nextStep(), SETTLE_MS);
    }, READ_MS);
    return;
  }
  if (step.kind === 'ask') {
    // A Bash call the CLI asks permission for, as `--permission-prompt-tool stdio` makes it: the call,
    // then a `can_use_tool` control request; the turn waits for the answer. Allowed, the call answers
    // `Allowed: <command>` without running it; denied, it fails. Either way the turn goes on as after
    // a command, reading what was said to it meanwhile
    const id = newToolId();
    const input = { command: step.text, description: `Run ${step.text}` };
    assistant([{ type: 'tool_use', id, name: 'Bash', input }]);
    const requestId = randomUUID();
    own.current = { id, child: null, command: step.text, asking: requestId };
    log('asked', { requestId, command: step.text });
    emit({ type: 'control_request', request_id: requestId, request: { subtype: 'can_use_tool', tool_name: 'Bash', input, tool_use_id: id } });
    return;
  }
  if (step.kind === 'say') {
    own.lastSaid = step.text;
    assistant([{ type: 'text', text: step.text }]);
    setTimeout(() => turn === own && nextStep(), SETTLE_MS);
    return;
  }
  if (step.kind === 'agent') return startAgent(own, step.text);
  if (step.kind === 'background') return startBackground(own, step.text);
  const command = step.text;
  const id = newToolId();
  // With hooks the call is announced first and the hook answers after it, as the CLI streams them
  const hooked = settingsFile !== undefined && hookCommands.PreToolUse !== undefined;
  if (hooked) {
    assistant([{ type: 'tool_use', id, name: 'Bash', input: { command, description: `Run ${command}` } }]);
    const blocked = bashBlock(id, command);
    if (blocked !== null) {
      log('command-blocked', { toolUseId: id, command });
      toolResult(id, blocked, true, `Error: ${blocked}`);
      afterTool(own);
      return;
    }
  }
  // A direct child of this process, the way the CLI's shell calls are: the wrapper finds it under our
  // pid, by its start time against the call's (it allows two seconds either way). It is started and
  // logged before the call is announced, so whoever reads the call can already find its pid in the log
  const child = spawn('sh', ['-c', command], { cwd: process.cwd(), stdio: ['ignore', 'pipe', 'pipe'] });
  log('command', { toolUseId: id, command, commandPid: child.pid });
  if (!hooked) assistant([{ type: 'tool_use', id, name: 'Bash', input: { command, description: `Run ${command}` } }]);
  const started = Date.now();
  let stdout = '';
  let stderr = '';
  child.stdout.on('data', (d) => (stdout += d));
  child.stderr.on('data', (d) => (stderr += d));
  const beat =
    HEARTBEAT_MS > 0
      ? setInterval(() => {
          const elapsed = elapsedOffsetS + Math.round((Date.now() - started) / 1000);
          emit({ type: 'tool_progress', uuid: randomUUID(), tool_use_id: id, tool_name: 'Bash', parent_tool_use_id: null, elapsed_time_seconds: elapsed });
        }, HEARTBEAT_MS)
      : null;
  own.current = { id, child, command };
  child.on('exit', (code, signal) => {
    if (beat) clearInterval(beat);
    if (turn !== own || own.current?.child !== child) return;
    own.current = null;
    log('command-ended', { toolUseId: id, command, code, signal, interrupted: own.interrupted });
    if (own.interrupted) {
      toolResult(id, 'The user interrupted this command.', true, 'Error: The user interrupted this command.');
      endTurn({ error: true });
      return;
    }
    const { content, isError, detail } = commandResult(stdout, stderr, code, signal);
    toolResult(id, content, isError, detail);
    afterTool(own);
  });
}

// ---------- branches: subagents and background commands ----------

/** Every subagent and background command still going, so nothing of ours outlives the process */
const branches = new Set();
const backgroundChildren = new Set();

/**
 * A subagent, as the CLI keeps it: its lines stream with `parent_tool_use_id` and go to its own
 * transcript, `<session>/subagents/agent-<agentId>.jsonl`, beside a `.meta.json` that names it.
 */
function openBranch(toolUseId, agentId, description, background) {
  const file = transcriptFile ? join(transcriptFile.slice(0, -'.jsonl'.length), 'subagents', `agent-${agentId}.jsonl`) : null;
  const branch = { toolUseId, agentId, description, background, stopped: false, children: new Set(), last: null, record: () => {} };
  if (file) {
    try {
      mkdirSync(dirname(file), { recursive: true });
      writeFileSync(file.replace(/\.jsonl$/, '.meta.json'), JSON.stringify({ agentType: 'Explore', description, toolUseId, ...(background ? { requestShape: 'background' } : {}) }));
    } catch {
      // a transcript that cannot be written only costs the spec its evidence
    }
    branch.record = (line) => {
      const full = { parentUuid: branch.last, isSidechain: true, parentToolUseID: toolUseId, agentId, ...line, timestamp: new Date().toISOString(), cwd: process.cwd(), sessionId, version: VERSION };
      if (full.uuid) branch.last = full.uuid;
      try {
        appendFileSync(file, `${JSON.stringify(full)}\n`);
      } catch {
        // as above
      }
    };
    branch.record({ type: 'user', uuid: randomUUID(), message: { role: 'user', content: 'Look around' } });
  }
  branches.add(branch);
  return branch;
}

function stopBranch(branch) {
  branch.stopped = true;
  for (const child of branch.children) killTree(child.pid);
  branches.delete(branch);
}

/**
 * The CLI's word that a task ended: `task_notification` on the stream, and in the transcript the
 * `<task-notification>` it queues for the model, which is what a reload reads the end from.
 */
function notify(taskId, toolUseId, status, summary) {
  emit({ type: 'system', subtype: 'task_notification', uuid: randomUUID(), task_id: taskId, tool_use_id: toolUseId, status, summary });
  record({ type: 'queue-operation', operation: 'enqueue', content: `<task-notification>\n<task-id>${taskId}</task-id>\n<tool-use-id>${toolUseId}</tool-use-id>\n<status>${status}</status>\n<summary>${summary}</summary>\n</task-notification>` });
}

/** Waits for `path` (against the working directory) to exist; no path goes on at once. */
function waitFor(path, branch, then) {
  if (!path) return then();
  const full = resolve(process.cwd(), path);
  const wait = setInterval(() => {
    if (branch.stopped) return clearInterval(wait);
    if (!existsSync(full)) return;
    clearInterval(wait);
    then();
  }, 50);
}

/**
 * A subagent's own steps, `read:` and `run:` as the main ones, each a call and its result on the
 * sidechain. A `hold: <path>` keeps the call before it open until the path exists, so a page can
 * read what the subagent is doing for as long as a spec needs. Ends with the subagent's report.
 */
function playSidechain(branch, steps, done) {
  const next = () => {
    if (branch.stopped) return;
    const step = steps.shift();
    if (step === undefined) {
      assistant([{ type: 'text', text: `Looked around for: ${branch.description}.` }], branch);
      return done();
    }
    const hold = steps[0]?.kind === 'hold' ? steps.shift().text : null;
    const answer = (send) =>
      waitFor(hold, branch, () => {
        if (branch.stopped) return;
        send();
        setTimeout(next, SETTLE_MS);
      });
    const id = newToolId();
    if (step.kind === 'read') {
      const filePath = resolve(process.cwd(), step.text);
      assistant([{ type: 'tool_use', id, name: 'Read', input: { file_path: filePath } }], branch);
      setTimeout(() => answer(() => {
        const { content, detail } = readResult(filePath);
        toolResult(id, content, false, detail, branch);
      }), READ_MS);
    } else if (step.kind === 'run') {
      const child = spawn('sh', ['-c', step.text], { cwd: process.cwd(), stdio: ['ignore', 'pipe', 'pipe'] });
      branch.children.add(child);
      assistant([{ type: 'tool_use', id, name: 'Bash', input: { command: step.text, description: `Run ${step.text}` } }], branch);
      let stdout = '';
      let stderr = '';
      child.stdout.on('data', (d) => (stdout += d));
      child.stderr.on('data', (d) => (stderr += d));
      child.on('exit', (code, signal) => {
        branch.children.delete(child);
        answer(() => {
          const { content, isError, detail } = commandResult(stdout, stderr, code, signal);
          toolResult(id, content, isError, detail, branch);
        });
      });
    } else waitFor(step.text, branch, next);
  };
  next();
}

/**
 * `agent: <description> | <sidechain script>`: one `Agent` call, its `task_started`, its sidechain,
 * then its result and `task_notification`. A description that starts with `background:` answers at
 * once (`async_launched`), and the sidechain and the notification follow the next step of the turn.
 */
function startAgent(own, text) {
  const [head = '', ...rest] = text.split('|');
  const background = /^\s*background:\s*/.test(head);
  const description = head.replace(/^\s*background:\s*/, '').trim();
  const steps = rest
    .join('|')
    .split(';')
    .map((l) => /^\s*(read|run|hold):\s*(.+)$/.exec(l))
    .filter((m) => m?.[2]?.trim())
    .map((m) => ({ kind: m[1], text: m[2].trim() }));
  const id = newToolId();
  // The CLI's agent ids are hex; the id names the agent's transcript and its task
  const agentId = `a${randomUUID().replaceAll('-', '').slice(0, 16)}`;
  const input = { description, subagent_type: 'Explore', prompt: 'Look around' };
  log('agent', { toolUseId: id, agentId, description, background });
  assistant([{ type: 'tool_use', id, name: 'Agent', input }]);
  const branch = openBranch(id, agentId, description, background);
  emit({ type: 'system', subtype: 'task_started', uuid: randomUUID(), task_id: agentId, tool_use_id: id, description, task_type: 'local_agent', is_backgrounded: background, prompt: input.prompt });
  const launched = { agentId, description, prompt: input.prompt, resolvedModel: model };
  const summary = `Looked around for: ${description}.`;
  const finish = () => {
    branches.delete(branch);
    log('agent-ended', { toolUseId: id, agentId });
    notify(agentId, id, 'completed', summary);
  };
  if (background) {
    toolResult(id, `Async agent launched successfully.\nagentId: ${agentId}`, false, { ...launched, status: 'async_launched', isAsync: true });
    own.launches.push(() => playSidechain(branch, steps, finish));
    afterTool(own);
    return;
  }
  own.current = { id, child: null, command: null, branch };
  playSidechain(branch, steps, () => {
    if (turn !== own) return;
    own.current = null;
    toolResult(id, `${summary}\nagentId: ${agentId}`, false, { ...launched, status: 'completed', content: [{ type: 'text', text: summary }] });
    finish();
    afterTool(own);
  });
}

/**
 * `background: <command>`: a `Bash` call with `run_in_background`, answered at once with its
 * `backgroundTaskId`, a `task_started`, the command run for real, and a `task_notification` when it ends.
 */
function startBackground(own, command) {
  const id = newToolId();
  const taskId = `b${randomUUID().replaceAll('-', '').slice(0, 8)}`;
  const description = `Run ${command}`;
  const child = spawn('sh', ['-c', command], { cwd: process.cwd(), stdio: 'ignore' });
  backgroundChildren.add(child);
  log('background', { toolUseId: id, taskId, command, commandPid: child.pid });
  assistant([{ type: 'tool_use', id, name: 'Bash', input: { command, description, run_in_background: true } }]);
  toolResult(id, `Command running in background with ID: ${taskId}.`, false, { stdout: '', stderr: '', interrupted: false, isImage: false, noOutputExpected: false, backgroundTaskId: taskId });
  emit({ type: 'system', subtype: 'task_started', uuid: randomUUID(), task_id: taskId, tool_use_id: id, description, task_type: 'local_bash', is_backgrounded: true });
  child.on('exit', (code, signal) => {
    backgroundChildren.delete(child);
    log('background-ended', { toolUseId: id, taskId, code, signal });
    const ok = code === 0;
    notify(taskId, id, ok ? 'completed' : 'failed', `Background command "${description}" ${ok ? 'completed' : 'failed'} (exit code ${code ?? signal})`);
  });
  afterTool(own);
}

/** The worker takes a moment before its next step, and reads what was said to it meanwhile. */
function afterTool(own) {
  setTimeout(() => {
    if (turn !== own) return;
    const said = waiting.splice(0);
    for (const { text, uuid } of said) {
      // As CLI 2.1 records a message it takes into the running turn: no `user` line, and the id it
      // was sent with as `source_uuid`
      record({ type: 'attachment', uuid: randomUUID(), attachment: { type: 'queued_command', prompt: text, ...(uuid ? { source_uuid: uuid } : {}), commandMode: 'prompt' } });
      record({ type: 'queue-operation', operation: 'remove', content: text, reason: 'absorbed_mid_turn', ...(uuid ? { commandUuid: uuid } : {}) });
      replay(text, uuid);
    }
    if (said.length) {
      log('absorbed', { texts: said.map((m) => m.text) });
      assistant(said.map((m) => heard(m.text)));
    }
    nextStep();
  }, SETTLE_MS);
}

/** The answer to a `can_use_tool` request an `ask:` step made. */
function permissionAnswer(message) {
  const response = message.response ?? {};
  const own = turn;
  if (!own?.current?.asking || response.request_id !== own.current.asking) return;
  const { id, command } = own.current;
  own.current = null;
  const allowed = response.response?.behavior === 'allow';
  log('answered', { requestId: response.request_id, allowed });
  toolResult(id, allowed ? `Allowed: ${command}` : 'Permission denied', !allowed);
  afterTool(own);
}

function streamEvent(event) {
  emit({ type: 'stream_event', parent_tool_use_id: null, event });
}

function streamDeltas(text) {
  for (let i = 0; i < text.length; i += 24) streamEvent({ type: 'content_block_delta', index: 0, delta: { type: 'input_json_delta', partial_json: text.slice(i, i + 24) } });
}

function finishStream(own) {
  streamDeltas(own.streamRest);
  streamEvent({ type: 'content_block_stop', index: 0 });
  own.streamRest = undefined;
}

function endTurn({ result = '', error = false, structured = undefined }) {
  const startedAt = turn?.startedAt ?? Date.now();
  turn = null;
  turns++;
  costUsd += TURN_COST_USD;
  emit({
    type: 'result',
    subtype: error ? 'error_during_execution' : 'success',
    is_error: error,
    duration_ms: Date.now() - startedAt,
    num_turns: 1,
    result,
    ...(structured === undefined ? {} : { structured_output: structured }),
    total_cost_usd: costUsd,
    usage: { input_tokens: 10, output_tokens: 10 },
  });
  log('result', { error, turns });
  // What was said during the turn and never answered is taken up now, one turn each
  for (const { text } of waiting) record({ type: 'queue-operation', operation: 'dequeue', content: text });
  inbox.push(...waiting.splice(0));
  const next = inbox.shift();
  if (next !== undefined) setImmediate(() => startTurn(next.text, next.uuid));
}

/**
 * The MCP servers `mcp_status` reports: a local server and a claude.ai connector waiting for its
 * authorisation, or the list in CLAUDIO_FAKE_CLI_MCP (JSON). `mcp_toggle` switches one, for this process.
 */
const mcpServers = (() => {
  try {
    if (env.CLAUDIO_FAKE_CLI_MCP) return JSON.parse(env.CLAUDIO_FAKE_CLI_MCP);
  } catch {
    // an unreadable override leaves the fake's own list
  }
  return [
    { name: 'docs', status: 'connected', scope: 'user', tools: [{ name: 'search', annotations: { readOnly: true } }, { name: 'write', annotations: {} }] },
    { name: 'claude.ai Calendar', status: 'needs-auth', scope: 'claudeai' },
  ];
})();


// ---------- context usage and /compact, from the recordings of packages/core/test/fixtures ----------

const FIXTURES = fileURLToPath(new URL('../../packages/core/test/fixtures/', import.meta.url));
const fixture = (path) => JSON.parse(readFileSync(join(FIXTURES, path), 'utf8'));
/** Two servers with 93 tools between them, all loaded: past the 80 at which the panel warns */
const MCP_TOOLS = { alpha: 47, beta: 46 };
const MCP_TOOL_TOKENS = 109;

/**
 * The recorded `get_context_usage` answer (`context-usage-summary.json` / `-full.json`), with the MCP
 * tools of two servers swapped in and the totals following them, so the warning shows. `detail` is
 * what the CLI accepts; the recording of a bad one is `context-usage-errors.json`.
 */
function contextUsage(detail) {
  const answer = fixture(`recordings/claude/context-usage-${detail}.json`);
  const mcpTools = Object.entries(MCP_TOOLS).flatMap(([serverName, count]) =>
    Array.from({ length: count }, (_, i) => ({ name: `mcp__${serverName}__tool_${i + 1}`, serverName, tokens: MCP_TOOL_TOKENS, isLoaded: true })),
  );
  const loaded = mcpTools.length * MCP_TOOL_TOKENS;
  const before = answer.categories.find((c) => c.name === 'MCP tools')?.tokens ?? 0;
  const categories = answer.categories.map((c) => (c.name === 'MCP tools' ? { ...c, tokens: loaded } : c));
  // The context after a compaction is the recorded `post_tokens`; before one it is what the recording held
  const totalTokens = compacted ? compacted.post : answer.totalTokens - before + loaded;
  return { ...answer, categories, mcpTools, totalTokens, percentage: Math.round((totalTokens / answer.maxTokens) * 100) };
}

/** Set once a `/compact` has succeeded: the context from then on is the recorded one after it */
let compacted = null;
const COMPACT_POST_TOKENS = 1655;
const COMPACT_SUMMARY = () => {
  const line = readFileSync(join(FIXTURES, 'replay/compact-manual.jsonl'), 'utf8')
    .split('\n').filter(Boolean).map((l) => JSON.parse(l)).find((m) => m.type === 'user' && m.message?.content?.startsWith('This session is being continued'));
  return line.message.content;
};

/**
 * A `/compact` played as the CLI plays it (`replay/compact-manual.jsonl`): `system/status` `compacting`,
 * then the status that ends it, the `compact_boundary`, the summary, the `<local-command-stdout>`
 * and a result. A text with the word `FAKE-COMPACT-FAIL` fails as `replay/compact-failed.jsonl`
 * does (the status, then `init`, the synthetic "Compaction canceled." line and a result); one with
 * `FAKE-COMPACT-SLOW` waits half a minute, for an interrupt to cut. An interrupt while it runs fails it.
 */
function startCompact(text, uuid) {
  record({ type: 'user', uuid: uuid ?? randomUUID(), message: { role: 'user', content: text } });
  replay(text, uuid);
  const own = { steps: [], current: null, startedAt: Date.now(), interrupted: false, scripted: true, lastSaid: '', structured: undefined, compacting: true };
  turn = own;
  log('turn', { text, commands: [], compact: true });
  emit({ type: 'system', subtype: 'status', status: 'compacting', uuid: randomUUID() });
  const slow = /FAKE-COMPACT-SLOW/.test(text);
  own.timer = setTimeout(() => {
    if (turn !== own) return;
    if (/FAKE-COMPACT-FAIL/.test(text)) failCompact(own);
    else finishCompact(own, text);
  }, slow ? 30_000 : COMPACT_MS);
}

function failCompact(own) {
  clearTimeout(own.timer);
  emit({ type: 'system', subtype: 'status', status: null, compact_result: 'failed', compact_error: 'API Error: Request was aborted.', uuid: randomUUID() });
  init();
  const uuid = randomUUID();
  const message = { id: randomUUID(), type: 'message', role: 'assistant', model: '<synthetic>', stop_reason: 'end_turn', usage: { input_tokens: 0, output_tokens: 0 }, content: [{ type: 'text', text: 'Compaction canceled.' }] };
  emit({ type: 'assistant', message, parent_tool_use_id: null, local_command_source: '<local-command-stdout>Compaction canceled.</local-command-stdout>', uuid });
  record({ type: 'assistant', uuid, message });
  endTurn({ result: '' });
}

function finishCompact(own, text) {
  // A fake chat reports a few tokens a turn; the recorded size stands in for a context worth compacting
  const pre = compacted ? compacted.post : Math.max(contextTokens, 18_517);
  const post = COMPACT_POST_TOKENS;
  const boundary = randomUUID();
  const summary = randomUUID();
  const durationMs = Date.now() - own.startedAt;
  emit({ type: 'system', subtype: 'status', status: null, compact_result: 'success', uuid: randomUUID() });
  emit({ type: 'system', subtype: 'compact_boundary', uuid: boundary, compact_metadata: { trigger: 'manual', pre_tokens: pre, post_tokens: post, cumulative_dropped_tokens: pre - post, duration_ms: durationMs }, logical_parent_uuid: lastLine });
  emit({ type: 'user', message: { role: 'user', content: COMPACT_SUMMARY() }, parent_tool_use_id: null, uuid: summary, timestamp: new Date().toISOString(), isReplay: false, isSynthetic: true });
  // The session file, in CLI 2.1's shape (recordings/claude/compacted.jsonl): camelCase, the boundary's
  // uuid the same as on stdout, the summary under it, then the command and what it printed
  record({ type: 'system', subtype: 'compact_boundary', uuid: boundary, parentUuid: null, logicalParentUuid: lastLine, content: 'Conversation compacted', isMeta: false, level: 'info', compactMetadata: { trigger: 'manual', preTokens: pre, durationMs, postTokens: post, cumulativeDroppedTokens: pre - post } });
  record({ type: 'user', uuid: summary, parentUuid: boundary, message: { role: 'user', content: COMPACT_SUMMARY() }, isVisibleInTranscriptOnly: true, isCompactSummary: true });
  const [, ...args] = text.trim().split(/\s+/);
  record({ type: 'user', uuid: randomUUID(), message: { role: 'user', content: `<command-name>/compact</command-name>\n<command-message>compact</command-message>\n<command-args>${args.join(' ')}</command-args>` } });
  const stdout = randomUUID();
  record({ type: 'user', uuid: stdout, message: { role: 'user', content: '<local-command-stdout>Compacted </local-command-stdout>' } });
  emit({ type: 'user', message: { role: 'user', content: '<local-command-stdout>Compacted </local-command-stdout>' }, parent_tool_use_id: null, uuid: stdout, timestamp: new Date().toISOString(), isReplay: true });
  compacted = { post };
  contextTokens = post;
  endTurn({ result: '' });
}

function control(message) {
  const request = message.request ?? {};
  const reply = (response) => emit({ type: 'control_response', response: { subtype: 'success', request_id: message.request_id, response } });
  log('control', { subtype: request.subtype });
  if (request.subtype === 'interrupt') {
    // The command running goes down with the turn, as the CLI's does; its exit ends the turn
    if (turn?.compacting) {
      // As the CLI aborts it: the compaction fails with the abort's own words
      failCompact(turn);
    } else if (turn?.current?.child) {
      turn.interrupted = true;
      killTree(turn.current.child.pid);
    } else if (turn) {
      // A question waiting for its answer is withdrawn, as the CLI does
      if (turn.current?.asking) emit({ type: 'control_cancel_request', request_id: turn.current.asking });
      // A foreground subagent goes down with the turn that waits for it
      if (turn.current?.branch) stopBranch(turn.current.branch);
      // A Read has no process to take down: the turn ends at once
      if (turn.current) toolResult(turn.current.id, 'The user interrupted this read.', true);
      turn.current = null;
      endTurn({ error: true });
    }
    reply({});
    return;
  }
  if (request.subtype === 'set_permission_mode' && typeof request.mode === 'string') {
    permissionMode = request.mode;
    emit({ type: 'system', subtype: 'status', permissionMode });
    reply({});
    return;
  }
  if (request.subtype === 'set_model' && typeof request.model === 'string') {
    model = modelName(request.model);
    reply({});
    return;
  }
  if (request.subtype === 'get_context_usage') {
    // Without `detail` the CLI answers `full`; anything else is refused in the words it recorded
    const detail = request.detail ?? 'full';
    if (detail !== 'summary' && detail !== 'full') {
      emit({ type: 'control_response', response: { subtype: 'error', request_id: message.request_id, error: "get_context_usage: detail must be 'summary' or 'full'" } });
      return;
    }
    reply(contextUsage(detail));
    return;
  }
  if (request.subtype === 'mcp_status') {
    reply({ mcpServers });
    return;
  }
  if (request.subtype === 'mcp_toggle' && typeof request.serverName === 'string') {
    const server = mcpServers.find((s) => s.name === request.serverName);
    if (!server) {
      emit({ type: 'control_response', response: { subtype: 'error', request_id: message.request_id, error: `No MCP server named ${request.serverName}` } });
      return;
    }
    server.status = request.enabled === false ? 'disabled' : server.scope === 'claudeai' ? 'needs-auth' : 'connected';
    reply({});
    return;
  }
  emit({ type: 'control_response', response: { subtype: 'error', request_id: message.request_id, error: `the fake CLI does not handle ${String(request.subtype)}` } });
}

let closing = false;
function shutdown() {
  if (closing) return;
  closing = true;
  // Nothing of ours outlives us: the command running now goes first
  if (turn?.current?.child) killTree(turn.current.child.pid, 'SIGKILL');
  for (const branch of branches) for (const child of branch.children) killTree(child.pid, 'SIGKILL');
  for (const child of backgroundChildren) killTree(child.pid, 'SIGKILL');
  log('exit');
  process.exit(0);
}

createInterface({ input: process.stdin })
  .on('line', (line) => {
    let message;
    try {
      message = JSON.parse(line);
    } catch {
      return;
    }
    if (message.type === 'control_request') return control(message);
    if (message.type === 'control_response') return permissionAnswer(message);
    if (message.type !== 'user') return;
    const text = textOf(message);
    const uuid = typeof message.uuid === 'string' ? message.uuid : null;
    log('stdin', { text, uuid });
    if (turn) {
      record({ type: 'queue-operation', operation: 'enqueue', content: text });
      waiting.push({ text, uuid });
    } else startTurn(text, uuid);
  })
  .on('close', () => {
    // The CLI ends what it was doing when its input ends, and says so with a result
    if (turn) {
      if (turn.current?.child) killTree(turn.current.child.pid, 'SIGKILL');
      turn.current = null;
      waiting.splice(0);
      endTurn({ error: true, result: 'stdin closed' });
    }
    shutdown();
  });

for (const signal of ['SIGTERM', 'SIGINT', 'SIGHUP']) process.on(signal, shutdown);
